# ─────────────────────────────────────────────────────────────
# PolicyTwin configuration. For LOCAL development every value is optional:
# with none set, the app runs fully offline (simulated PayPal, deterministic
# agents, in-memory store, open access in a shared "local" workspace).
# ─────────────────────────────────────────────────────────────

# ── Access control (REQUIRED in production) ───────────────────
# NODE_ENV=production without DEMO_PASSCODE and SESSION_SECRET makes every protected endpoint answer
# 503 AUTH_NOT_CONFIGURED — the app fails closed instead of running open on the internet.
# Visitors enter DEMO_PASSCODE once and receive a signed, HttpOnly, SameSite=Lax (Secure over https) session cookie.
DEMO_PASSCODE=
# At least 16 characters; use a long random value (Render can generate one: see render.yaml). Never commit it.
SESSION_SECRET=
SESSION_TTL_HOURS=8

# ── Abuse limits (defaults shown) ─────────────────────────────
# Per session: runs and policies. Per day (all sessions): LLM-backed agent calls — beyond it agents use the deterministic fallback.
MAX_RUNS_PER_SESSION=12
MAX_POLICIES_PER_SESSION=20
MAX_AI_CALLS_PER_DAY=150
# In-process sliding-window limits, applied per session AND per client IP (single instance; see README).
RATE_LIMIT_READ_PER_MIN=240
RATE_LIMIT_WRITE_PER_MIN=40
RATE_LIMIT_HEAVY_PER_MIN=8
RATE_LIMIT_LOGIN_PER_15MIN=8
RATE_LIMIT_WEBHOOK_PER_MIN=300

# ── PostgreSQL (optional). Unset → in-memory store (data lost on restart).
# Schema v2 needs a FRESH database (the app refuses to start on a v1 schema rather than guess a migration).
DATABASE_URL=
# Set to true for hosts that require TLS with a non-public CA.
DATABASE_SSL=

# ── OpenAI structured outputs (optional). Unset → deterministic fallback agents.
OPENAI_API_KEY=
# Any model that supports Structured Outputs. Check OpenAI's current model list.
OPENAI_MODEL=gpt-4o

# ── PayPal SANDBOX REST app credentials (optional). Unset → simulated PayPal.
# Create a Sandbox app in the PayPal Developer Dashboard (Apps & Credentials → Sandbox).
# PolicyTwin refuses to start the live adapter against a non-sandbox base URL.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Sandbox webhook id (from the Sandbox app's webhook configuration), used to verify signatures.
PAYPAL_WEBHOOK_ID=
PAYPAL_MERCHANT_ID=

# ── Direct-card Sandbox testing (OFF by default) ──────────────
# Orders v2 normally needs buyer approval. To let a SERVER confirm an order without a browser, PolicyTwin can send a
# Sandbox TEST card to PayPal. PayPal's documentation says handling raw card numbers requires PCI SAQ D compliance, and the
# recommended path is the JavaScript SDK / Hosted Fields (which this project does NOT implement). Therefore this path needs
# BOTH variables below; the card is read from the environment only, sent on the wire only, and never stored, logged,
# returned or put in a report. Needs "Advanced Credit and Debit Card Payments" on the sandbox business account and a
# Sandbox test card (Developer Dashboard → Sandbox → Credit Card Generator). Use Sandbox test cards only.
PAYPAL_ALLOW_DIRECT_CARD_SANDBOX=0
PAYPAL_SANDBOX_CARD_NUMBER=
PAYPAL_SANDBOX_CARD_EXPIRY=2029-12
PAYPAL_SANDBOX_CARD_NAME=Test Buyer

# ── Opt-in LIVE validation (never run by default; see docs/LIVE_VALIDATION.md) ──
#   PAYPAL_LIVE_TESTS=1 npm run test:integration     (needs the PayPal Sandbox credentials above)
#   EVAL_LIVE=1 npm run test:evals                   (needs OPENAI_API_KEY)
# Evidence files are written to EVIDENCE_DIR (default ./evidence).
PAYPAL_LIVE_TESTS=0
EVAL_LIVE=0
EVIDENCE_DIR=evidence

# ── Logging ───────────────────────────────────────────────────
# Logs are always passed through the financial-evidence sanitizer. Tests are quiet unless this is 1.
POLICYTWIN_LOG=
